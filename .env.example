# ============================================================================
# MESSI Environment Configuration
# ============================================================================
# Copy this file to .env.local and populate with your actual values.
# Required variables must be set for the application to run.

# ============================================================================
# AI & LLM Configuration
# ============================================================================

# GEMINI_API_KEY (Required)
# Your Google Gemini API key for AI functionality
# Get it from: https://aistudio.google.com/app/apikey
# Format: String (typically 39+ characters)
GEMINI_API_KEY=

# ============================================================================
# Application Configuration
# ============================================================================

# APP_URL (Required)
# The public URL where this application is hosted
# Example for local development: http://localhost:3000
# Example for production: https://yourdomain.com
# Used for: OAuth callbacks, self-referential links, API endpoints
APP_URL=

# ============================================================================
# Optional Configuration
# ============================================================================

# NODE_ENV (Optional)
# Application environment: 'development', 'staging', or 'production'
# Default: 'development'
# NODE_ENV=development

# LOG_LEVEL (Optional)
# Logging verbosity: 'debug', 'info', 'warn', or 'error'
# Default: 'info'
# LOG_LEVEL=info
