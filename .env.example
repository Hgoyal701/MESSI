# ============================================================================
# MESSI Environment Configuration
# ============================================================================
# Copy this file to .env.local and populate with your actual values.
# Required variables must be set for the application to run.
# Documentation: See README.md for detailed setup instructions.
# ============================================================================
# AI & LLM Configuration
# ============================================================================

# GEMINI_API_KEY (Required)
# Your Google Gemini API key for AI-powered features
# Get it from: https://aistudio.google.com/app/apikey
# Format: String (typically 39+ characters)
GEMINI_API_KEY=
# Required for: AI generation, content analysis, and LLM requests
# ============================================================================
# Application Configuration
# ============================================================================

# APP_URL (Required)
# The public URL where this application is hosted
# Examples:
#   Development: http://localhost:3000
#   Staging: https://staging.yourdomain.com
#   Production: https://yourdomain.com
# Used for: OAuth callbacks, self-referential links, API endpoints, webhooks
# Note: Must include protocol (http:// or https://)
APP_URL=

# ============================================================================
# Server Configuration
# ============================================================================

# NODE_ENV (Optional)
# Application environment mode
# Values: 'development' | 'staging' | 'production'
# Default: 'development'
# NODE_ENV=development
# Application environment mode
# Values: 'development' | 'staging' | 'production'
# Default: 'development'
# NODE_ENV=development

# PORT (Optional)
# Server port number
# Default: 3000
# PORT=3000

# ============================================================================
# Logging Configuration
# ============================================================================

# LOG_LEVEL (Optional)
# Logging verbosity level
# Values: 'debug' | 'info' | 'warn' | 'error'
# Default: 'info'
# LOG_LEVEL=info

# ============================================================================
# Database Configuration (if applicable)
# ============================================================================

# DATABASE_URL (Optional)
# Connection string for your database
# Example PostgreSQL: postgresql://user:password@localhost:5432/messi_db
# Example MongoDB: mongodb://user:password@localhost:27017/messi
# DATABASE_URL=

# ============================================================================
# Authentication & Security (if applicable)
# ============================================================================

# JWT_SECRET (Optional)
# Secret key for signing JWT tokens
# Generate with: openssl rand -base64 32
# JWT_SECRET=

# OAUTH_CLIENT_ID (Optional)
# OAuth provider client ID
# OAUTH_CLIENT_ID=

# OAUTH_CLIENT_SECRET (Optional)
# OAuth provider client secret
# OAUTH_CLIENT_SECRET=

# ============================================================================
# AI Studio Integration (Auto-injected)
# ============================================================================
# The following variables are automatically injected by AI Studio
# at runtime and do not need to be manually configured:
# - GEMINI_API_KEY (from Secrets panel)
# - APP_URL (from Cloud Run service URL)
# You can still override them by setting values above.

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. COPY THE FILE
#    cp .env.example .env.local
#
# 2. CONFIGURE REQUIRED VARIABLES
#    - GEMINI_API_KEY: Visit https://aistudio.google.com/app/apikey and copy your API key
#    - APP_URL: Set to your application's public URL
#
# 3. CONFIGURE OPTIONAL VARIABLES (as needed)
#    - NODE_ENV: Set based on your environment (development/staging/production)
#    - PORT: Change if port 3000 is already in use
#    - LOG_LEVEL: Adjust logging verbosity as needed
#    - DATABASE_URL: If using a database, provide connection string
#    - JWT_SECRET: Generate secure secret for token signing
#
# 4. ENVIRONMENT-SPECIFIC SETUP
#    Development: Use localhost URLs and development credentials
#    Production: Use HTTPS URLs and secure credentials from secrets manager
#
# 5. SECURITY BEST PRACTICES
#    - Never commit .env.local to version control
#    - Add .env.local to .gitignore
#    - Use strong, randomly generated secrets for production
#    - Rotate secrets periodically
#    - Use environment variable management tools (e.g., AWS Secrets Manager, Vault)
#
# 6. VERIFICATION
#    After setup, verify all required variables are set:
#    - echo $GEMINI_API_KEY (should not be empty)
#    - echo $APP_URL (should not be empty)
#
# ============================================================================
# Troubleshooting
# ============================================================================
# - Variables not loading? Check file is named .env.local (not .env.example)
# - Port already in use? Change PORT variable or kill existing process
# - API key errors? Verify GEMINI_API_KEY is correct and API is enabled
# - URL issues? Ensure APP_URL includes protocol (http:// or https://)
